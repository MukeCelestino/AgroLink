rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True for a signed-in user whose own Users doc has isAdmin: true.
    // Used to gate the seller/transporter verification review flow below.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.isAdmin == true;
    }

    // True for a signed-in user whose own Users doc lists `role` in
    // verifiedRoles (set only by an admin approving a VerificationRequest —
    // see the review flow above). This is the real backstop: the client UI
    // already hides seller/transporter mode from unverified users, but this
    // is what stops a direct Firestore write from bypassing that.
    function isVerifiedFor(role) {
      return request.auth != null &&
        role in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.verifiedRoles;
    }

    // User profiles: anyone signed in can read (needed to show seller/buyer
    // names), but you can only write your own document. isAdmin,
    // verifiedRoles, and verificationStatus are admin-only fields — a user
    // can never set or change them on themselves, only an admin can
    // (via the VerificationRequests review flow, see below).
    match /Users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['isAdmin', 'verifiedRoles', 'verificationStatus']);

      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['isAdmin', 'verifiedRoles', 'verificationStatus']))
        || isAdmin()
      );
    }

    // Marketplace listings: a seller's remaining stock. Buying some of it
    // never changes who owns the listing — it only shrinks `quantity`/`price`
    // and, once stock hits 0, flips `status` to 'closed'. The actual
    // purchase lifecycle (ordered -> in_transit -> delivered) lives on a
    // separate Order document (see /Orders below).
    match /Listings/{listingId} {
      allow read: if request.auth != null;

      // Only a verified seller can create a listing, and it must start as 'listed'.
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'listed'
        && isVerifiedFor('seller');

      allow update: if request.auth != null && (
        // Seller managing their own listing.
        (resource.data.sellerId == request.auth.uid) ||
        // Any signed-in buyer completing a (partial) purchase: identity,
        // item, and pricePerUnit may never change, quantity may only shrink,
        // and status may only move listed -> listed or listed -> closed.
        (
          resource.data.status == 'listed'
          && (request.resource.data.status == 'listed' || request.resource.data.status == 'closed')
          && request.resource.data.quantity >= 0
          && request.resource.data.quantity <= resource.data.quantity
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.item == resource.data.item
          && request.resource.data.pricePerUnit == resource.data.pricePerUnit
        )
      );

      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // A single buyer's purchase against a listing. Created atomically with
    // the matching Listing quantity decrement (see MarketStore.buyListing).
    match /Orders/{orderId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'ordered';

      allow update: if request.auth != null && (
        // Seller of the underlying listing.
        (resource.data.sellerId == request.auth.uid) ||
        // The assigned transporter posting route updates / marking delivered.
        (resource.data.transporterId == request.auth.uid) ||
        // A verified transporter accepting an ordered item (ordered -> in_transit).
        (resource.data.status == 'ordered'
          && request.resource.data.status == 'in_transit'
          && request.resource.data.transporterId == request.auth.uid
          && isVerifiedFor('transporter'))
      );
    }

    // Buyer "wanted" posts.
    match /BuyRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.buyerId == request.auth.uid;
    }

    // Seller/transporter verification requests. A user can create and read
    // their own; an admin can read every request and is the only one who
    // can update one (to approve/reject it) — see verificationService.ts.
    match /VerificationRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin();
    }

    // Real-time messaging (see messagingService.ts). One thread per
    // participant pair. 'agrolink-system' is a reserved, non-auth sender id
    // used for one-way verification-decision notices — every rule below
    // treats a conversation containing it as admin-only to write to, which
    // is what makes that channel one-way server-side, not just in the UI.
    match /Conversations/{conversationId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        (isAdmin() && 'agrolink-system' in resource.data.participantIds)
      );

      // Regular users can start conversations among themselves; only an
      // admin (the verification review flow) can create one involving the
      // system sender.
      allow create: if request.auth != null && (
        (request.auth.uid in request.resource.data.participantIds
          && !('agrolink-system' in request.resource.data.participantIds))
        || (isAdmin() && 'agrolink-system' in request.resource.data.participantIds)
      );

      // Any real participant can update the conversation doc itself (this
      // covers lastMessage/lastMessageAt bookkeeping on normal threads, and
      // the lastReadAt.<uid> read-receipt a user writes on *any* thread
      // they're in, including a system one — they just can't post a
      // Message into a system thread, which is enforced separately below.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );

      match /Messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.participantIds ||
          isAdmin()
        );

        // A normal participant can post into a normal conversation, but
        // never into one that includes the system sender — that's
        // admin-only, and only as senderId == 'agrolink-system'. This is
        // what actually blocks a user from replying in a system thread,
        // even via a raw Firestore write.
        allow create: if request.auth != null && (
          (request.resource.data.senderId == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.participantIds
            && !('agrolink-system' in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.participantIds))
          || (isAdmin() && request.resource.data.senderId == 'agrolink-system')
        );
      }
    }
  }
}
